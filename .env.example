# Telegram Bot Token (BotFather dan olingan)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google Gemini AI API kaliti (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Hugging Face Token (ixtiyoriy Whisper STT uchun)
HF_TOKEN=your_hf_token_here

# PostgreSQL ma'lumotlar bazasi (agar ulanmasa, avtomatik SQLite ishlaydi)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=postgres

# Bot adminining Telegram ID si
ADMIN_ID=123456789
